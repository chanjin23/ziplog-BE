# 사용법: 이 파일을 복사해 .env 를 만들고 값을 채운다 (.env 는 커밋되지 않음)
#   cp .env.sample .env                 (macOS / Linux / Git Bash)
#   Copy-Item .env.sample .env          (Windows PowerShell)

# 공공데이터포털 인증키 - 마이페이지 "일반 인증키(Encoding)" 값을 그대로 붙여넣기 (추가 인코딩 금지)
# 매매: https://www.data.go.kr/data/15126469/openapi.do
DATA_GO_KR_APT_BRG_SERVICE_KEY=
# 전월세: https://www.data.go.kr/data/15126474/openapi.do
DATA_GO_KR_APT_RENT_SERVICE_KEY=

# (선택) DB 접속 정보. 비워두면 compose.yaml 기본값(localhost:5434, ziplog/ziplog) 사용
# DB_URL=jdbc:postgresql://localhost:5434/ziplog
# DB_USERNAME=ziplog
# DB_PASSWORD=ziplog
